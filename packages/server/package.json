{
	"name": "@http3-server/server",
	"type": "module",
	"version": "0.3.1",
	"description": "HTTP/3, WebTransport, and WebSocket server for Node.js",
	"license": "MIT-0",
	"engines": {
		"node": ">=22"
	},
	"author": "Jonathan Neal",
	"repository": {
		"type": "git",
		"url": "https://github.com/http3-server/http3-server.git",
		"directory": "packages/server"
	},
	"homepage": "https://github.com/http3-server/http3-server/tree/main/packages/server",
	"bugs": {
		"url": "https://github.com/http3-server/http3-server/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"keywords": [
		"http3",
		"quic",
		"websocket",
		"webtransport",
		"server",
		"networking"
	],
	"types": "./types.d.ts",
	"exports": {
		".": {
			"types": "./types.d.ts",
			"default": "./index.js"
		}
	},
	"scripts": {
		"test": "node --test test/server.test.js test/http-server.test.js test/send-headers-best-effort.test.js test/websocket.test.js && npm run test:types",
		"test:types": "tsc -p ../../tsconfig.json",
		"test:integration": "node --test test/integration.test.js"
	},
	"files": [
		"Connection.js",
		"HTTP3Server.js",
		"HTTPServer.js",
		"index.js",
		"internal/fetch-adapter.js",
		"internal/mapOf.js",
		"internal/send-headers-best-effort.js",
		"LICENSE.md",
		"NOTICE",
		"README.md",
		"Stream.js",
		"WebTransportSession.js",
		"WebTransportStream.js",
		"WebSocketConnection.js",
		"types.d.ts"
	],
	"dependencies": {
		"@http3-server/native": "0.3.1"
	},
	"devDependencies": {
		"@types/node": "24.13.3"
	}
}
