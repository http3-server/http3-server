root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = tab
indent_style = tab
insert_final_newline = true
tab_width = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.patch]
insert_final_newline = false
trim_trailing_whitespace = false

[*.yaml]
indent_size = 2
indent_style = space
